# ---- Servidor ----
PORT=8787
# Origen(es) del frontend permitidos por CORS (separa con coma)
APP_ORIGIN=https://presentacion.soluctiasas.com
# Dominio de la cookie de sesión (vacío = host actual). Ej: presentacion.soluctiasas.com
COOKIE_DOMAIN=
SESSION_SECRET=pon-aqui-una-cadena-larga-aleatoria
# Contraseña para entrar al panel
PANEL_PASSWORD=cambia-esta-clave
# Secreto para los endpoints de cron (?key=...)
CRON_SECRET=pon-otra-cadena-aleatoria

# ---- MySQL (datos del hosting) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=u154452028_panel
MYSQL_PASSWORD=
MYSQL_DATABASE=u154452028_panel

# ---- Microsoft Graph (registro de app en Entra ID) ----
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Buzón a monitorear (UPN / correo)
MAILBOX=contacto@soluctiasas.com
# URL pública del webhook (este backend + /api/graph/notifications)
GRAPH_WEBHOOK_URL=https://api.presentacion.soluctiasas.com/api/graph/notifications
GRAPH_WEBHOOK_SECRET=una-cadena-secreta-para-validar

# ---- IA (opcional; 'none' = solo reglas) ----
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Meta de tasa de respuesta para las alertas (%)
RESPONSE_RATE_TARGET=85
